@page "/playlists/{playlistId}"
@model SpotifyPlaylistSorter.Pages.Playlists.SelectedModel
@{
    ViewData["Title"] = Model.Playlist is null ? "Playlist selected" : Model.Playlist.Name;
}

@if (Model.Playlist is not null)
{
    <section class="selection-confirmation">
        <a class="back-link" asp-page="/Playlists/Index">← Choose a different playlist</a>
        <p class="eyebrow">Playlist selected</p>
        <h1>@Model.Playlist.Name</h1>
        <p class="lead text-secondary">Build a proposed order beside the playlist’s current Spotify order. Nothing changes in Spotify until you approve it.</p>
        <dl class="selection-details">
            <div>
                <dt>Owner</dt>
                <dd>@Model.Playlist.OwnerName</dd>
            </div>
            <div>
                <dt>Items</dt>
                <dd>@Model.Items.Count</dd>
            </div>
            <div>
                <dt>Access</dt>
                <dd>@Model.Playlist.AccessLabel</dd>
            </div>
        </dl>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center gap-2" role="status">
            <span>@Model.SuccessMessage</span>
            @if (!string.IsNullOrWhiteSpace(Model.SuccessSpotifyUrl))
            {
                <a class="alert-link" href="@Model.SuccessSpotifyUrl" target="_blank" rel="noopener noreferrer">Open in Spotify</a>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert">
            <span>@Model.ErrorMessage</span>
            <a class="alert-link" asp-page="/Playlists/Selected" asp-route-playlistId="@Model.Playlist.Id">Try again</a>
        </div>
    }
    else
    {
        @if (Model.Items.Count == 0)
        {
            <section class="playlist-items" aria-labelledby="playlist-items-heading">
                <div class="items-heading">
                    <div>
                        <p class="eyebrow">Loaded from Spotify</p>
                        <h2 id="playlist-items-heading">Current order</h2>
                    </div>
                    <span class="count-pill">0</span>
                </div>
                <div class="items-empty-state">
                    <span aria-hidden="true">♪</span>
                    <div>
                        <h3>This playlist is empty</h3>
                        <p class="text-secondary mb-0">Add some items in Spotify, then return here and reload.</p>
                    </div>
                </div>
            </section>
        }
        else
        {
            <section class="sort-controls" aria-labelledby="sort-controls-heading">
                <div>
                    <p class="eyebrow">Build your preview</p>
                    <h2 id="sort-controls-heading">Choose how to organize the playlist</h2>
                    <p class="order-description">Start with artist groups, arrange them however you like, then organize each artist’s albums.</p>
                </div>
                <div class="sort-actions">
                    <button class="btn btn-spotify" type="button" data-bs-toggle="modal" data-bs-target="#artistOrderModal">
                        Sort by artist
                    </button>
                    <button class="btn btn-outline-dark" id="sort-by-album" type="button">
                        Sort by album
                    </button>
                    <button class="btn btn-link reset-preview" id="reset-preview" type="button">
                        Reset preview
                    </button>
                </div>
            </section>

            <section class="playlist-comparison" aria-label="Current and proposed playlist order comparison">
                <article class="playlist-items" aria-labelledby="current-order-heading">
                    <div class="items-heading">
                        <div>
                            <p class="eyebrow">Loaded from Spotify</p>
                            <h2 id="current-order-heading">Current order</h2>
                            <p class="order-description">The playlist exactly as it is now.</p>
                        </div>
                        <span class="count-pill">@Model.Items.Count</span>
                    </div>
                    <partial name="_PlaylistItemsList" model="@(new PlaylistItemsListDisplay(Model.Items, "Playlist items in their current Spotify order"))" />
                </article>

                <article class="playlist-items proposed-order" aria-labelledby="proposed-order-heading">
                    <div class="items-heading">
                        <div>
                            <p class="eyebrow">Preview only</p>
                            <h2 id="proposed-order-heading">Proposed order</h2>
                            <p class="order-description" id="proposed-order-description" aria-live="polite">Matches the current order until you choose a sort.</p>
                        </div>
                        <span class="count-pill" id="moved-item-count" title="@Model.MovedItemCount items would move">@Model.MovedItemCount moved</span>
                    </div>
                    <partial name="_PlaylistItemsList" model="@(new PlaylistItemsListDisplay(Model.ProposedItems, "Playlist items in their proposed order", ShowOriginalPosition: true, ElementId: "proposed-track-list"))" />
                </article>
            </section>

            <section class="save-order-panel" aria-labelledby="save-order-heading">
                <div class="save-order-heading">
                    <div>
                        <p class="eyebrow">Save to Spotify</p>
                        <h2 id="save-order-heading">Choose what happens to this playlist</h2>
                        <p class="order-description">Creating a private copy is the safest option. Updating the original changes its order for everyone who uses it.</p>
                    </div>
                    <span class="save-order-status" id="save-order-status" aria-live="polite">Choose a sort to enable saving.</span>
                </div>
                <div class="save-order-options">
                    <form class="save-order-option save-order-copy"
                          method="post"
                          asp-page-handler="CreateCopy"
                          asp-route-playlistId="@Model.Playlist.Id">
                        <input type="hidden" name="snapshotId" value="@Model.Playlist.SnapshotId" />
                        <input type="hidden" name="orderedPositions" value="" data-order-input />
                        <div>
                            <h3>Create a sorted copy</h3>
                            <p>Leaves “@Model.Playlist.Name” untouched and creates a new private playlist.</p>
                        </div>
                        <label class="form-label" for="copy-name">New playlist name</label>
                        <input class="form-control"
                               id="copy-name"
                               name="copyName"
                               value="@($"{Model.Playlist.Name} (Sorted)")"
                               maxlength="100"
                               required />
                        <button class="btn btn-spotify save-order-button"
                                type="submit"
                                disabled
                                data-save-supported="@(Model.CanCreateCopy ? "true" : "false")">
                            Create sorted copy
                        </button>
                        @if (Model.LocalItemCount > 0)
                        {
                            <p class="save-order-note">Spotify cannot copy local files through its API. The new playlist will omit @Model.LocalItemCount local @(Model.LocalItemCount == 1 ? "file" : "files"); the original playlist will not be affected.</p>
                        }
                        @if (!Model.CanCreateCopy)
                        {
                            <p class="save-order-note">Copying is unavailable because this playlist also contains an unavailable Spotify item.</p>
                        }
                    </form>

                    <div class="save-order-option save-order-original">
                        <div>
                            <h3>Update the original</h3>
                            <p>Applies the proposed order directly to “@Model.Playlist.Name”.</p>
                        </div>
                        <button class="btn btn-outline-dark save-order-button"
                                type="button"
                                data-bs-toggle="modal"
                                data-bs-target="#updateOriginalModal"
                                data-save-supported="true"
                                disabled>
                            Update original playlist
                        </button>
                    </div>
                </div>
            </section>

            <div class="modal fade" id="artistOrderModal" tabindex="-1" aria-labelledby="artistOrderModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content artist-order-modal">
                        <div class="modal-header">
                            <div>
                                <p class="eyebrow">Artist groups</p>
                                <h2 class="modal-title fs-4" id="artistOrderModalLabel">Choose the artist order</h2>
                            </div>
                            <div class="artist-find">
                                <label class="visually-hidden" for="artist-find-input">Find artist</label>
                                <span class="artist-find-icon" aria-hidden="true">⌕</span>
                                <input class="form-control"
                                       id="artist-find-input"
                                       type="search"
                                       placeholder="Find artist"
                                       autocomplete="off"
                                       aria-describedby="artist-find-status"
                                       title="Press Enter for the next match; Shift+Enter for the previous match" />
                                <span class="artist-find-status" id="artist-find-status" aria-live="polite"></span>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="artist-order-intro">
                                <p>Type a position number or drag artists into the order you want. Tracks by the same album artist will stay together.</p>
                                <button class="btn btn-sm btn-outline-dark" id="alphabetize-artists" type="button">Sort artists A–Z</button>
                            </div>
                            <ol class="artist-order-list" data-artist-order-list aria-label="Artists in proposed order">
                                @for (var artistIndex = 0; artistIndex < Model.ArtistNames.Count; artistIndex++)
                                {
                                    var artistName = Model.ArtistNames[artistIndex];
                                    <li class="artist-order-item" draggable="true" data-artist-name="@artistName">
                                        <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                                        <input class="artist-order-index"
                                               type="number"
                                               min="1"
                                               max="@Model.ArtistNames.Count"
                                               value="@(artistIndex + 1)"
                                               inputmode="numeric"
                                               aria-label="Sorting position for @artistName" />
                                        <span class="artist-order-name">@artistName</span>
                                        <span class="artist-order-buttons">
                                            <button type="button" class="artist-move-button" data-move="up" aria-label="Move @artistName up">↑</button>
                                            <button type="button" class="artist-move-button" data-move="down" aria-label="Move @artistName down">↓</button>
                                        </span>
                                    </li>
                                }
                            </ol>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="button" class="btn btn-spotify" id="apply-artist-order" data-bs-dismiss="modal">Apply artist order</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="updateOriginalModal" tabindex="-1" aria-labelledby="updateOriginalModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form method="post"
                              asp-page-handler="UpdateOriginal"
                              asp-route-playlistId="@Model.Playlist.Id">
                            <input type="hidden" name="snapshotId" value="@Model.Playlist.SnapshotId" />
                            <input type="hidden" name="orderedPositions" value="" data-order-input />
                            <div class="modal-header">
                                <div>
                                    <p class="eyebrow">Confirm Spotify update</p>
                                    <h2 class="modal-title fs-4" id="updateOriginalModalLabel">Update the original playlist?</h2>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>This will change the order of <strong>“@Model.Playlist.Name”</strong> in Spotify. The playlist’s items will stay the same.</p>
                                <p class="text-secondary mb-0">If Spotify changed since this preview was built, the app will stop and ask you to reload instead of applying a stale order.</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-dark">Yes, update the original</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
}

@section Scripts {
    <script src="~/js/playlist-sorter.js" asp-append-version="true"></script>
}
